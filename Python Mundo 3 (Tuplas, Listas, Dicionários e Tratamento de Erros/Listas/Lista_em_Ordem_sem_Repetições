lista = [] #ou list()
iCont = numAmzd = 0

while True:
    numero = int(input("Digite um número: ")) 
    
    if len(lista) == 0 or numero > lista[-1]:
        lista.append(numero)
    else:
        while numero in lista: #Verifica se o número ja está na lista
            numero = int(input("Digite um número que não contenha  na lista: "))

        for iCont in range(len(lista)): #Iniciaremos a varredura no vetor a cada número digitado
            if numero <= lista[iCont]:
                lista.insert(iCont, numero)
                #lista.insert(iCont + 1, numAmzd) #erro do códgio: quando damos um insert em uma lista, o número é inserido no indice, porem o produto que estava no indice é realocado para o indice seguinte, desse modo estava ocorrendo uma dupla alocação
                break

        resposta = input("Deseja continuar? [S/N]")

        while resposta.upper().strip()[0] not in "SN":
            resposta = input("Digite uma opção valoda [S/N]: ")

        if resposta.upper().strip()[0] == 'N':
            break

print(lista)